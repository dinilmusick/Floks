{
  "name": "@floks/canvas-ui",
  "version": "1.0.0",
  "description": "Floks Canvas UI \u2014 Reusable React Visual Components for Infinite Canvas, Dock, Tile Menus, Code Editor, and Node Cards",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./canvas": {
      "import": "./dist/canvas/index.js",
      "types": "./dist/canvas/index.d.ts"
    },
    "./dock": {
      "import": "./dist/dock/index.js",
      "types": "./dist/dock/index.d.ts"
    },
    "./tile-menu": {
      "import": "./dist/tile-menu/index.js",
      "types": "./dist/tile-menu/index.d.ts"
    },
    "./editor": {
      "import": "./dist/editor/index.js",
      "types": "./dist/editor/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/canvas/index.ts src/dock/index.ts src/tile-menu/index.ts src/editor/index.ts --format esm --dts --clean --external react --external react-dom --external @floks/ui --external monaco-editor --external @dnd-kit/core --external @dnd-kit/sortable --external @dnd-kit/utilities",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@floks/ui": "file:../ui"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^8.0.0 || ^9.0.0",
    "@dnd-kit/utilities": "^3.0.0",
    "monaco-editor": "^0.50.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  }
}
