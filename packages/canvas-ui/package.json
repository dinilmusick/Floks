{
  "name": "@floks/canvas-ui",
  "version": "1.0.0",
  "description": "Floks Canvas UI — Reusable React Visual Components for Infinite Canvas, Dock, Tile Menus, Code Editor, and Node Graphs",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "skipoManifest": "./floks.manifest.json",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./canvas": {
      "import": "./dist/canvas/index.js",
      "types": "./dist/canvas/index.d.ts",
      "default": "./dist/canvas/index.js"
    },
    "./dock": {
      "import": "./dist/dock/index.js",
      "types": "./dist/dock/index.d.ts",
      "default": "./dist/dock/index.js"
    },
    "./tile-menu": {
      "import": "./dist/tile-menu/index.js",
      "types": "./dist/tile-menu/index.d.ts",
      "default": "./dist/tile-menu/index.js"
    },
    "./editor": {
      "import": "./dist/editor/index.js",
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./graph-2d": {
      "import": "./dist/graph-2d/index.js",
      "types": "./dist/graph-2d/index.d.ts",
      "default": "./dist/graph-2d/index.js"
    },
    "./predictive": {
      "import": "./dist/predictive/index.js",
      "types": "./dist/predictive/index.d.ts",
      "default": "./dist/predictive/index.js"
    },
    "./frnl-editable-node-graph": {
      "import": "./dist/frnl-editable-node-graph/index.js",
      "types": "./dist/frnl-editable-node-graph/index.d.ts",
      "default": "./dist/frnl-editable-node-graph/index.js"
    },
    "./authoring": {
      "import": "./dist/authoring/index.js",
      "types": "./dist/authoring/index.d.ts",
      "default": "./dist/authoring/index.js"
    },
    "./fod": {
      "import": "./dist/fod/index.js",
      "types": "./dist/fod/index.d.ts",
      "default": "./dist/fod/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/canvas/index.ts src/dock/index.ts src/tile-menu/index.ts src/editor/index.ts src/authoring/index.ts src/graph-2d/index.ts src/predictive/index.ts src/frnl-editable-node-graph/index.ts src/fod/index.ts --format esm --dts --clean --external react --external react-dom --external lucide-react --external @floks/ui --external @ultrst-armada/frnlts --external @kloks/state-graph --external @kloks/audio-midi --external monaco-editor --external @dnd-kit/core --external @dnd-kit/sortable --external @dnd-kit/utilities"
  },
  "dependencies": {
    "@floks/ui": "workspace:*",
    "@ultrst-armada/frnlts": "^0.2.7",
    "@ultrst-armada/kloks": "^1.18.0"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^8.0.0 || ^9.0.0",
    "@dnd-kit/utilities": "^3.0.0",
    "monaco-editor": "^0.50.0",
    "react": "^18.0.0 || ^19.0.0",
    "@ultrst-armada/kloks": "^1.12.0"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  }
}
