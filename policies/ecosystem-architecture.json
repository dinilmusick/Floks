  "dependencyEdgeTypes": {
    "library-dependency": {
      "direction": "consumer-to-provider",
      "layerRule": "Provider layer must be strictly lower than consumer layer when both have numeric L0-L3 layers.",
      "affectsCycleDetection": true,
      "packageManifestEvidence": true
    },
    "application-composition": {
      "direction": "composed-application-to-composed-capability",
      "layerRule": "Applications may compose declared libraries and authorities; this is not a library-layer edge.",
      "affectsCycleDetection": true,
      "packageManifestEvidence": false
    },
    "capability-authority": {
      "direction": "capability-consumer-to-authority-owner",
      "layerRule": "Must terminate at the unique owner of the named capability.",
      "affectsCycleDetection": true,
      "packageManifestEvidence": false
    },
    "authorization-delegation": {
      "direction": "profile-or-resource-owner-to-authorization-authority",
      "layerRule": "Application authorization decisions delegate to SRKL; authentication/session validity delegates to Luth.",
      "affectsCycleDetection": true,
      "packageManifestEvidence": false
    },
    "runtime-integration": {
      "direction": "application-or-service-to-runtime-provider",
      "layerRule": "Runtime integration cannot claim identity, credentials, or application authorization ownership.",
      "affectsCycleDetection": true,
      "packageManifestEvidence": false
    },
    "theme-consumption": {
      "direction": "theme-consumer-to-theme-provider",
      "layerRule": "UI consumers may consume Theta assets; theme provider does not depend on consuming applications.",
      "affectsCycleDetection": true,
      "packageManifestEvidence": false
    },
    "governance-promotion": {
      "direction": "governed-repository-to-governance-process",
      "layerRule": "Promotion and policy relationships are governance metadata, not runtime imports.",
      "affectsCycleDetection": false,
      "packageManifestEvidence": false
    }
  },
