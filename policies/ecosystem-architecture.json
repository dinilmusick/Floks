  "runtimeCompatibility": {
    "environments": [
      "node",
      "browser",
      "edge",
      "webcontainer"
    ],
    "rules": [
      "Every public export must declare its supported runtime set.",
      "A package entry point must not statically import modules unavailable in any runtime declared for that entry point.",
      "Node-only dependencies must be isolated behind Node-only exports or lazy runtime adapters.",
      "Browser exports must not expose filesystem, process, native Node APIs, server credentials, or server-only modules.",
      "Edge exports must not require unsupported Node built-ins, native addons, or long-lived process facilities.",
      "WebContainer support must be declared separately and tested; it must not be inferred from Node compatibility.",
      "Conditional exports must resolve to runtime-compatible implementations and declarations."
