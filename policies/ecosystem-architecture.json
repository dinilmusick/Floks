{
  "policyVersion": "2.0.0",
  "schemaVersion": "1.0.0",
  "policyId": "ultrst-armada.ecosystem-architecture",
  "status": "authoritative",
  "compatibility": {
    "policyMajor": 2,
    "schema": "https://json-schema.org/draft/2020-12/schema",
    "consumersMustDeclare": [
      "policyId",
      "policyVersion",
      "schemaVersion"
    ],
    "sameMajor": "Compatible additive changes may be adopted without changing the policy major version. Validators must ignore unknown optional fields but must reject unknown enum values in fields they enforce.",
    "breaking": "Changes that alter ownership, dependency direction, required declarations, or existing public surfaces require a policy major version increment and a documented migration.",
    "schemaCompatibility": "A schema major change may invalidate documents accepted by an earlier schema major and requires an explicit migration.",
    "legacyV1": "Version 1 documents remain readable as legacy projections during migration, but are not authoritative. Repositories must migrate to policy version 2 before enforcing the complete graph.",
    "migration": [
      "Read the canonical policy and record its policyVersion and schemaVersion in local validation metadata.",
      "Replace independently authored architecture rules with a generated or synchronized projection of this policy.",
      "Map legacy level/edge declarations to typed library-dependency edges.",
      "Classify every additional relationship as application-composition, capability-authority, authorization-delegation, runtime-integration, theme-consumption, or governance-promotion.",
      "Resolve conflicts by preserving working public APIs through an explicit compatibility exception with owner, rationale, scope, and expiry or removal condition.",
      "Run repository-local validation and publish the validated policy version in CI evidence."
    ]
  },
  "layers": {
    "L0": {
      "name": "Foundational primitives",
      "rule": "May not depend on any higher layer or application."
    },
    "L1": {
      "name": "Framework foundations",
      "rule": "May depend on L0 only."
    },
    "L2": {
      "name": "Reusable ecosystem libraries",
      "rule": "May depend on L0 and L1 only."
    },
    "L3": {
      "name": "Application composition framework",
      "rule": "May consume L0-L2; must not become an alternative capability authority."
    },
    "application": {
      "name": "Application",
      "rule": "Composes canonical capabilities and owns product-specific behavior only."
    },
    "authority": {
      "name": "Canonical authority service",
      "rule": "Owns one explicitly assigned ecosystem capability; does not imply a numeric library layer."
    },
    "governance": {
      "name": "Ecosystem governance",
      "rule": "Defines and enforces policy and promotion workflows; is not a runtime dependency of libraries."
    },
    "integration": {
      "name": "Runtime integration",
      "rule": "Connects applications and authorities to execution environments without taking over their capabilities."
    },
    "theme": {
      "name": "Theme distribution",
      "rule": "Publishes theme assets consumed by UI foundations and applications."
    },
    "consumer": {
      "name": "Downstream consumer",
      "rule": "Consumes published packages and canonical services; does not define their architecture."
    }
  },
