{
  "name": "@ultrst-armada/floks",
  "version": "2.0.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Floks — Public Frontend, 2D Graph & UI Package Library (@floks/*) — canonical Luth client integration",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "packages/*/dist/**",
    "packages/*/src/theme/tokens.css",
    "packages/*/src/styles/**",
    "packages/*/package.json",
    "packages/*/floks.manifest.json",
    ".krusbl-release-attestation.json",
    "scripts/normalize-package-declarations.mjs"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./ui": {
      "types": "./packages/ui/dist/index.d.ts",
      "import": "./packages/ui/dist/index.js",
      "default": "./packages/ui/dist/index.js"
    },
    "./ui/dist/index.css": "./packages/ui/dist/index.css",
    "./ui/theme/tokens.css": "./packages/ui/src/theme/tokens.css",
    "./ui/styles/*": "./packages/ui/src/styles/*",
    "./canvas-ui": {
      "types": "./packages/canvas-ui/dist/index.d.ts",
      "import": "./packages/canvas-ui/dist/index.js",
      "default": "./packages/canvas-ui/dist/index.js"
    },
    "./contracts": {
      "types": "./packages/contracts/dist/index.d.ts",
      "import": "./packages/contracts/dist/index.js",
      "default": "./packages/contracts/dist/index.js"
    },
    "./ui/ai": {
      "types": "./packages/ui/dist/components/ai/index.d.ts",
      "import": "./packages/ui/dist/components/ai/index.js",
      "default": "./packages/ui/dist/components/ai/index.js"
    },
    "./ai": {
      "types": "./packages/ui/dist/components/ai/index.d.ts",
      "import": "./packages/ui/dist/components/ai/index.js",
      "default": "./packages/ui/dist/components/ai/index.js"
    },
    "./canvas-ui/fod": {
      "types": "./packages/canvas-ui/dist/fod/index.d.ts",
      "import": "./packages/canvas-ui/dist/fod/index.js",
      "default": "./packages/canvas-ui/dist/fod/index.js"
    },
    "./canvas-ui/aiko": {
      "types": "./packages/canvas-ui/dist/aiko/index.d.ts",
      "import": "./packages/canvas-ui/dist/aiko/index.js",
      "default": "./packages/canvas-ui/dist/aiko/index.js"
    },
    "./auth": {
      "types": "./packages/ui/dist/components/auth/index.d.ts",
      "import": "./packages/ui/dist/components/auth/index.js",
      "default": "./packages/ui/dist/components/auth/index.js"
    },
    "./ui/services": {
      "types": "./packages/ui/dist/serviceUIComponents/index.d.ts",
      "import": "./packages/ui/dist/serviceUIComponents/index.js",
      "default": "./packages/ui/dist/serviceUIComponents/index.js"
    },
    "./ui/timeline": {
      "types": "./packages/ui/dist/components/timeline/index.d.ts",
      "import": "./packages/ui/dist/components/timeline/index.js",
      "default": "./packages/ui/dist/components/timeline/index.js"
    },
    "./universal": {
      "types": "./packages/contracts/dist/index.d.ts",
      "import": "./packages/contracts/dist/index.js",
      "default": "./packages/contracts/dist/index.js"
    }
  },
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 pnpm -r --workspace-concurrency=1 run build && NODE_OPTIONS=--max-old-space-size=4096 pnpm --filter @floks/ui run build:types && NODE_OPTIONS=--max-old-space-size=4096 pnpm --filter @floks/canvas-ui run build:types && node scripts/normalize-package-declarations.mjs",
    "postbuild": "node scripts/normalize-package-declarations.mjs",
    "test": "vitest run && pnpm run verify:npm-trusted-publishing",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "boundary": "node scripts/architecture-boundary.mjs",
    "boundary:clean-room": "node scripts/clean-room-boundary.mjs",
    "boundary:relative": "node scripts/relative-package-boundary.mjs",
    "test:consumer-browser": "node scripts/consumer-browser-boundary.mjs",
    "test:consumer-server": "node scripts/consumer-server-boundary.mjs",
    "verify:npm-trusted-publishing": "node scripts/verify-npm-trusted-publishing.mjs"
  },
  "dependencies": {
    "@dinilmusick/gutts": "^2.0.3",
    "@ultrst-armada/frnlts": "^0.5.23",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "lucide-react": ">=0.300.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@xyflow/react": "^12.8.6",
    "d3-force": "^3.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@ultrst-armada/frnlts": "^0.5.23",
    "happy-dom": "^21.0.3",
    "lucide-react": "^1.55.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.0",
    "zustand": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinilmusick/Floks.git"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@dinilmusick/gutts"
    ]
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@xyflow/react": {
      "optional": true
    },
    "d3-force": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  }
}
