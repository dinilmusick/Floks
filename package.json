{
  "name": "@ultrst-armada/floks",
  "version": "1.12.1",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Floks — Public Frontend, 2D Graph & UI Package Library (@floks/*)",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "packages/*/dist/**",
    "packages/*/src/theme/tokens.css",
    "packages/*/src/styles/**",
    "packages/*/package.json",
    "packages/*/floks.manifest.json",
    ".krusbl-release-attestation.json"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./ui": {
      "types": "./packages/ui/dist/index.d.ts",
      "import": "./packages/ui/dist/index.js",
      "default": "./packages/ui/dist/index.js"
    },
    "./ui/dist/index.css": "./packages/ui/dist/index.css",
    "./ui/theme/tokens.css": "./packages/ui/src/theme/tokens.css",
    "./ui/styles/*": "./packages/ui/src/styles/*",
    "./canvas-ui": {
      "types": "./packages/canvas-ui/dist/index.d.ts",
      "import": "./packages/canvas-ui/dist/index.js",
      "default": "./packages/canvas-ui/dist/index.js"
    },
    "./contracts": {
      "types": "./packages/contracts/dist/index.d.ts",
      "import": "./packages/contracts/dist/index.js",
      "default": "./packages/contracts/dist/index.js"
    },
    "./ui/ai": {
      "types": "./packages/ui/dist/components/ai/index.d.ts",
      "import": "./packages/ui/dist/components/ai/index.js",
      "default": "./packages/ui/dist/components/ai/index.js"
    },
    "./ai": {
      "types": "./packages/ui/dist/components/ai/index.d.ts",
      "import": "./packages/ui/dist/components/ai/index.js",
      "default": "./packages/ui/dist/components/ai/index.js"
    },
    "./canvas-ui/fod": {
      "types": "./packages/canvas-ui/dist/fod/index.d.ts",
      "import": "./packages/canvas-ui/dist/fod/index.js",
      "default": "./packages/canvas-ui/dist/fod/index.js"
    },
    "./canvas-ui/aiko": {
      "types": "./packages/canvas-ui/dist/aiko/index.d.ts",
      "import": "./packages/canvas-ui/dist/aiko/index.js",
      "default": "./packages/canvas-ui/dist/aiko/index.js"
    }
  },
  "scripts": {
    "build": "pnpm -r run build",
    "postbuild": "node -e \"import('fs').then(fs => { for (const pkg of fs.readdirSync('packages')) { const d = 'packages/' + pkg + '/dist'; if (!fs.existsSync(d)) continue; for (const f of fs.readdirSync(d, { recursive: true })) { const p = d + '/' + f; if (fs.statSync(p).isFile() && (p.endsWith('.js') || p.endsWith('.d.ts'))) { const c = fs.readFileSync(p, 'utf8'); const n = c.replaceAll('@kloks/', '@ultrst-armada/kloks/').replaceAll('@floks/', '@ultrst-armada/floks/').replaceAll('@ultrst/kloks/', '@ultrst-armada/kloks/').replaceAll('@ultrst/floks/', '@ultrst-armada/floks/').replaceAll('\\\"kloks/', '\\\"@ultrst-armada/kloks/').replaceAll('\\'kloks/', '\\'@ultrst-armada/kloks/').replaceAll('\\\"floks/', '\\\"@ultrst-armada/floks/').replaceAll('\\'floks/', '\\'@ultrst-armada/floks/'); if (c !== n) fs.writeFileSync(p, n); } } } })\"",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "dependencies": {
    "@ultrst-armada/frnlts": "^0.4.0",
    "@xyflow/react": "^12.8.6",
    "d3-force": "^3.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3",
    "@dinilmusick/gutts": "^1.2.0"
  },
  "peerDependencies": {
    "@ultrst-armada/kloks": "^1.17.0",
    "lucide-react": ">=0.300.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@ultrst-armada/kloks": "^1.22.2",
    "@ultrst-armada/frnlts": "^0.4.0",
    "happy-dom": "^21.0.3",
    "lucide-react": "^1.55.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.0",
    "zustand": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinilmusick/Floks.git"
  }
}
